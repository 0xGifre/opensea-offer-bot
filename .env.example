# Copy this file to .env and enter your own credentials locally.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
PRIVATE_KEY=0xYOUR_WALLET_PRIVATE_KEY
OPENSEA_API_KEY=YOUR_OPENSEA_API_KEY

NFT_CONTRACT=0x0000000000000000000000000000000000000000
OFFER_AMOUNT_WETH=0.0001
OFFER_EXPIRATION_SECONDS=86400

# Optional: manual, activity, or random. Leave blank to show the startup menu.
RUN_MODE=
TOKEN_IDS=1,2,3
COLLECTION_SLUG=
RANDOM_ID_START=1
RANDOM_ID_END=30000
ACTIVITY_POLL_SECONDS=10
ACTIVITY_INITIAL_LOOKBACK_SECONDS=120
OFFER_DELAY_SECONDS=1
STATE_FILE=offer_state.json
